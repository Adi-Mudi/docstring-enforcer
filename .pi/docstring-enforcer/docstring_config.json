{
  "ignoreExtensions": [
    ".md",
    ".txt",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".csv",
    ".html",
    ".css",
    ".scss",
    ".less",
    ".svg",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".excalidraw",
    ".db",
    ".sqlite",
    ".sqlite3",
    ".sql"
  ],
  "ignorePatterns": [
    "node_modules/",
    ".git/",
    "dist/",
    "build/",
    "out/",
    "coverage/",
    ".next/",
    ".venv/",
    "venv/",
    "__pycache__/",
    "*.min.js",
    "*.d.ts"
  ],
  "ignoreFiles": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    ".env",
    ".env.example",
    ".gitignore",
    ".piignore"
  ],
  "supportedLanguages": {
    ".js": "javascript",
    ".ts": "javascript",
    ".tsx": "javascript",
    ".mjs": "javascript",
    ".gs": "javascript",
    ".py": "python",
    ".rs": "rust",
    ".r": "r",
    ".c": "c",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".cxx": "cpp",
    ".hpp": "cpp",
    ".hh": "cpp",
    ".hxx": "cpp"
  },
  "pythonStyle": null,
  "strictMode": false
}
